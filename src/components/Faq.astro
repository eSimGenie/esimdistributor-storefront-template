---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Frequently asked questions' } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<section aria-labelledby="faq-title">
  <h2 id="faq-title" class="text-2xl font-bold sm:text-3xl">{title}</h2>
  <div class="mt-6 divide-y divide-line rounded-2xl border border-line bg-card">
    {items.map((i) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
          {i.q}
          <span aria-hidden="true" class="text-xl text-muted transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-muted">{i.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</section>
