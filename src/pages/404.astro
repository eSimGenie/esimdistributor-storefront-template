---
import Base from '../layouts/Base.astro';
export const prerender = false;
---

<Base title="Page not found" noindex>
  <div class="container-page max-w-xl py-20 text-center">
    <p class="text-6xl font-extrabold text-brand dark:text-fg">404</p>
    <h1 class="mt-4 text-2xl font-bold">We couldn't find that page</h1>
    <p class="mt-3 text-muted">The destination or plan may no longer be available.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/destinations" class="btn btn-primary">Browse destinations</a>
      <a href="/" class="btn btn-ghost">Home</a>
    </div>
  </div>
</Base>
