---
import Base from '../layouts/Base.astro';
import DestinationCard from '../components/DestinationCard.astro';
import SearchFilter from '../components/SearchFilter.astro';
import Faq from '../components/Faq.astro';
import { site } from '../lib/site';
import { getServices } from '../lib/runtime';
import { getDestinations, type PublicDestination } from '../lib/catalog';
import { benefits, homeFaq, steps } from '../lib/content';
import { PUBLIC_PAGE_CACHE } from '../lib/http';

const services = getServices(Astro.locals);
let destinations: PublicDestination[] = [];
let catalogError = false;
try {
  destinations = await getDestinations(services.catalog);
} catch (e) {
  console.error('[home] catalog unavailable', e);
  catalogError = true;
}

const byCode = new Map(destinations.map((d) => [d.code.toLowerCase(), d]));
let featured = site.featuredDestinations.map((c) => byCode.get(c.toLowerCase())).filter((d): d is PublicDestination => !!d);
if (featured.length === 0) featured = [...destinations].sort((a, b) => b.planCount - a.planCount).slice(0, 8);

if (!catalogError) Astro.response.headers.set('Cache-Control', PUBLIC_PAGE_CACHE);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brandName,
  url: site.websiteUrl,
  email: site.supportEmail,
  ...(site.logoUrl ? { logo: new URL(site.logoUrl, site.websiteUrl).toString() } : {}),
};
---

<Base title={`${site.brandName} — travel eSIMs`} description={site.tagline} path="/" jsonLd={jsonLd}>
  <section class="bg-brand-soft">
    <div class="container-page py-14 sm:py-20">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand dark:text-fg">Travel eSIM</p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Stay connected in {destinations.length > 0 ? `${destinations.length}+ destinations` : 'every destination'}</h1>
        <p class="mt-4 text-lg text-muted">{site.tagline}</p>
        <div class="mt-8">
          <SearchFilter target="#featured-list" />
        </div>
        {services.mock && (
          <p class="mt-4 rounded-lg border border-dashed border-line bg-card px-3 py-2 text-sm">
            <strong>Mock mode:</strong> demo catalog, no real payments or eSIMs. Set <code>RESELLER_API_KEY</code> to go live.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="container-page py-12" aria-labelledby="featured-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="featured-title" class="text-2xl font-bold sm:text-3xl">Popular destinations</h2>
      <a href="/destinations" class="text-sm font-semibold text-brand dark:text-fg">All destinations →</a>
    </div>
    {catalogError ? (
      <p class="card mt-6 p-6 text-muted">Our plans are temporarily unavailable. Please try again in a few minutes.</p>
    ) : (
      <Fragment>
        <ul id="featured-list" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {featured.map((d) => (
            <li>
              <DestinationCard dest={d} />
            </li>
          ))}
          {destinations
            .filter((d) => !featured.includes(d))
            .map((d) => (
              <li hidden data-default-hidden>
                <DestinationCard dest={d} />
              </li>
            ))}
        </ul>
        <p data-filter-empty hidden class="mt-6 text-muted">No destination matches. <a class="text-brand underline" href="/destinations">Browse all</a>.</p>
      </Fragment>
    )}
  </section>

  <section class="bg-surface" aria-labelledby="how-title">
    <div class="container-page py-14">
      <h2 id="how-title" class="text-2xl font-bold sm:text-3xl">How it works</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="card p-6">
            <span class="grid size-10 place-items-center rounded-full bg-brand font-bold text-brand-fg" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="why-title">
    <h2 id="why-title" class="text-2xl font-bold sm:text-3xl">Why {site.brandName}</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map((b) => (
        <li>
          <h3 class="font-bold">{b.title}</h3>
          <p class="mt-2 text-muted">{b.body}</p>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/compatibility" class="btn btn-ghost">Check your phone</a>
      <a href="/install" class="btn btn-ghost">See the install guide</a>
    </div>
  </section>

  <div class="container-page pb-6">
    <Faq items={homeFaq(site)} />
  </div>
</Base>
